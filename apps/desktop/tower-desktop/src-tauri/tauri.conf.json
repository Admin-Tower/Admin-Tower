{
  "$schema": "../../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Admin-Tower",
  "version": "0.0.0",
  "identifier": "io.github.admintower.desktop",
  "build": {
    "frontendDist": "../../../../dist/apps/web/tower-ui/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "pnpm -w exec nx serve tower-ui",
    "beforeBuildCommand": "pnpm -w exec nx build tower-ui"
  },
  "app": {
    "windows": [
      {
        "title": "Admin-Tower",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
